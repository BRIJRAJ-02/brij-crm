{
  "name": "@crm/marketing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:site": "vite --port 5180",
    "build": "vite build && vite build --ssr src/render.tsx --outDir dist-ssr && node scripts/prerender.ts",
