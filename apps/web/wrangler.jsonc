{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links load the app.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker first; everything else is a static asset.
    "run_worker_first": ["/api/*"]
  },
  // API_ORIGIN_INTERNAL is set per environment: in the Cloudflare dashboard for
  // production, with --var on each preview upload, and in .dev.vars locally.
  "keep_vars": true,
  "observability": { "enabled": true }
}
