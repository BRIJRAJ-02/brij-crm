{
  "name": "@crm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --watch src/worker.ts",
    "start": "node src/server.ts",
    "start:worker": "node src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
