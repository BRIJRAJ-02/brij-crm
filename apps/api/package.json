{
  "name": "@crm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import ./src/monitoring/instrument.ts --watch src/server.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --import ./src/monitoring/instrument.ts --watch src/worker.ts",
    "start": "node --import ./src/monitoring/instrument.ts src/server.ts",
    "start:worker": "node --import ./src/monitoring/instrument.ts src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@crm/contracts": "workspace:*",
    "@crm/core": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/emails": "workspace:*",
    "@hono/node-server": "catalog:",
    "@orpc/server": "catalog:",
    "@sentry/node": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "better-auth": "catalog:",
    "free-email-domains": "catalog:",
    "graphile-worker": "catalog:",
    "hono": "catalog:",
    "posthog-node": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crm/config": "workspace:*",
    "@orpc/client": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
