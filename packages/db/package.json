{
  "name": "@crm/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./stats": "./src/stats.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "app-login": "node --env-file-if-exists=../../.env scripts/app-login.ts",
    "identity-login": "node --env-file-if-exists=../../.env scripts/identity-login.ts",
    "worker-login": "node --env-file-if-exists=../../.env scripts/worker-login.ts",
    "reconcile:sort-keys": "node --env-file-if-exists=../../.env scripts/reconcile-sort-keys.ts",
    "check:journal": "node scripts/journal.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "graphile-worker": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crm/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
