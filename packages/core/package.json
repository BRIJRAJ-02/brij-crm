{
  "name": "@crm/core",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./system": "./src/system.ts",
    "./testing": "./src/testing.ts",
    "./scale-budget": "./scripts/scale-budget.ts",
    "./load-sessions": "./scripts/load-sessions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:scale": "node --env-file-if-exists=../../.env scripts/seed-scale.ts",
    "bench:scale": "node --env-file-if-exists=../../.env scripts/bench-scale.ts",
    "member:add": "node --env-file-if-exists=../../.env scripts/add-member.ts"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@crm/db": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@crm/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
