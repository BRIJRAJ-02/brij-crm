{
  "name": "@crm/ui",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./theme": "./src/theme/theme.ts",
    "./vite": "./src/vite.ts",
    "./grid": "./src/grid.ts",
    "./charts": "./src/charts.ts",
    "./alignment-probe": "./src/lib/alignment-probe.ts",
    "./editor": "./src/editor/index.ts",
    "./public-form": "./src/public-form/hosted-form.ts",
    "./public-booking": "./src/public-booking/booking.ts",
    "./public-booking/visitor": "./src/public-booking/visitor.ts",
    "./public-booking/details": "./src/public-booking/details.ts",
    "./public-booking/chat": "./src/public-booking/chat.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project stories --project unit --project browser --project perf",
    "test:unit": "vitest run --project unit",
    "test:visual": "node scripts/test-visual.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "ui:artifact": "node scripts/artifact/build.ts"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@crm/tokens": "workspace:*",
    "@internationalized/date": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-heading": "catalog:",
    "@tiptap/extension-highlight": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-task-item": "catalog:",
    "@tiptap/extension-task-list": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "libphonenumber-js": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-aria": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@crm/config": "workspace:*",
    "@react-aria/live-announcer": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "jsqr": "catalog:",
    "playwright": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "storybook": "catalog:",
