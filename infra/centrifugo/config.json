{
  "http_server": {
    "port": 8000,
    "internal_port": "9000"
  },
  "engine": {
    "type": "memory"
  },
  "client": {
    "allowed_origins": []
  },
  "channel": {
    "namespaces": [
      {
        "name": "workspace",
        "allow_subscribe_for_client": false,
        "history_size": 100,
        "history_ttl": "300s",
        "force_recovery": true
      }
    ]
  },
  "admin": {
    "enabled": true
  },
  "health": {
    "enabled": true
  }
}
