{
  "name": "crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev dev:worker",
    "dev:apps": "turbo run dev dev:worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @crm/db generate",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "db:app-login": "pnpm --filter @crm/db app-login",
    "db:setup": "pnpm db:migrate && pnpm db:app-login",
    "db:seed:scale": "pnpm --filter @crm/core seed:scale",
    "db:bench:scale": "pnpm --filter @crm/core bench:scale",
    "boundaries": "turbo boundaries",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint .railway eslint.config.js stylelint.config.js",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "house-rules": "node packages/config/scripts/house-rules.ts",
    "tokens:build": "pnpm --filter @crm/tokens build:tokens",
    "tokens:check": "pnpm --filter @crm/tokens check:tokens",
    "check": "turbo run typecheck lint lint:root && pnpm format:check && pnpm lint:css && pnpm boundaries && pnpm house-rules && pnpm tokens:check",
    "test": "turbo run test",
    "test:visual": "pnpm --filter @crm/ui test:visual",
    "size": "turbo run build --filter=@crm/web && pnpm --filter @crm/web size",
    "ui:artifact": "pnpm --filter @crm/ui ui:artifact",
    "storybook": "pnpm --filter @crm/ui storybook"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "railway": "catalog:",
    "stylelint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
