# Local development. Copy to .env (never committed). Values match docker-compose.yml.
# Deployed environments keep these in Railway and Vercel variables, never in a file.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=local                         # local | preview | production
NODE_ENV=development
PORT=3000                             # api
WORKER_PORT=3001                      # worker health endpoint

# ── Origins ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173         # the one public origin for the app and the API
# TRUSTED_ORIGINS=                    # extra origins allowed to write, comma separated

# ── Postgres ─────────────────────────────────────────────────────────────────
# Pooled (PgBouncer, transaction mode), as the app login role: API request queries.
DATABASE_URL=postgres://crm_app_user:crm_app_local@localhost:6432/crm
# Direct, as the app login role: LISTEN, the relay and jobs.
DATABASE_URL_DIRECT=postgres://crm_app_user:crm_app_local@localhost:5433/crm
# Direct, as the owner role: migrations and `pnpm db:app-login` only.
DATABASE_URL_OWNER=postgres://crm_owner:crm_owner_local@localhost:5433/crm

# ── Joining with later features (listed so nothing is a surprise) ───────────
# Realtime (#7):      REALTIME_URL, CENTRIFUGO_API_URL, CENTRIFUGO_API_KEY, CENTRIFUGO_TOKEN_SECRET
# Sign in (#23):      BETTER_AUTH_SECRET, BETTER_AUTH_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# Email (#23):        RESEND_API_KEY, MAIL_FROM
# Files (#32):        R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
# Monitoring (#11):   SENTRY_DSN_WEB, SENTRY_DSN_SERVER, SENTRY_AUTH_TOKEN, SENTRY_RELEASE, POSTHOG_KEY, POSTHOG_HOST
