# Local development. Copy to .env (never committed). Values match docker-compose.yml.
# Deployed environments keep these in Railway and Vercel variables, never in a file.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=local                         # local | preview | production
# No NODE_ENV here: the web build reads this file, and NODE_ENV=development
# makes Vite ship React's development build. The api defaults it to development.
PORT=3000                             # api
WORKER_PORT=3001                      # worker health endpoint

# ── Origins ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173         # the one public origin for the app and the API
# TRUSTED_ORIGINS=                    # extra origins allowed to write, comma separated

# ── Edge guard (spec 0005) ───────────────────────────────────────────────────
# The secret Vercel's middleware sends as x-crm-edge, so the API answers only
# requests that came through the app. Leave it empty locally: the API never
# enforces it when APP_ENV=local. Deployed: 32+ printable characters with no
# spaces (`openssl rand -hex 32`), one value for production (Vercel Production
# and Railway production) and a different one for previews (Vercel Preview and
# Railway preview-base), so preview code never holds production's secret.
EDGE_SECRET=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Pooled (PgBouncer, transaction mode), as the app login role: API request queries.
DATABASE_URL=postgres://crm_app_user:crm_app_local@localhost:6432/crm
# Direct, as the app login role: LISTEN, the relay and jobs.
DATABASE_URL_DIRECT=postgres://crm_app_user:crm_app_local@localhost:5433/crm
# Direct, as the owner role: migrations and `pnpm db:app-login` only.
DATABASE_URL_OWNER=postgres://crm_owner:crm_owner_local@localhost:5433/crm
# As the identity login (crm_identity), the only role that reads and writes schema `auth`
# (sessions, accounts, sign in codes). `pnpm db:identity-login` creates it. Direct locally:
# the local PgBouncer knows only the app login. Deployed, it is pooled like DATABASE_URL.
IDENTITY_DATABASE_URL=postgres://crm_identity_user:crm_identity_local@localhost:5433/crm

# ── Sign in (spec 0005) ──────────────────────────────────────────────────────
# Signs sessions. This placeholder is for a laptop only; the API refuses it anywhere else.
# Deployed: `openssl rand -base64 32`, a different value per environment.
BETTER_AUTH_SECRET=local-only-better-auth-secret-not-for-deployment
# The public origin (APP_URL), never the Railway host.
BETTER_AUTH_URL=http://localhost:5173
# Google sign in: both or neither. Without them the button hides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails allowed to sign up, comma separated. Unset locally means anyone; unset in previews
# and production means no one new (an existing user always signs in).
SIGNUP_ALLOWLIST=

# ── Email ────────────────────────────────────────────────────────────────────
# Mailpit (docker-compose.yml): the local inbox and its API. Sign in codes land here.
MAILPIT_URL=http://localhost:8025
# Resend, required in previews and production (MAILPIT_URL is ignored there). With a key set
# locally, codes go out through Resend instead of Mailpit.
RESEND_API_KEY=
# The sender. Locally anything works (default "CRM <sign-in@crm.localhost>"); deployed,
# onboarding@resend.dev until a domain is verified in Resend.
MAIL_FROM=

# ── Realtime (spec 0005) ─────────────────────────────────────────────────────
# The worker's relay publishes change events to Centrifugo's server API (the internal port,
# docker-compose.yml's CENTRIFUGO_HTTP_API_KEY). Leave both empty to run the worker with the
# relay off; deployed, both are required: the URL https, or http to a *.railway.internal host,
# and the key 32+ characters (this local key is refused there).
CENTRIFUGO_API_URL=http://localhost:9000
CENTRIFUGO_API_KEY=local-centrifugo-api-key
# The relay goes dormant while nothing is written, so Neon's compute can sleep, and the api pokes
# the worker after each write. The worker's internal address (the api; deployed:
# http://worker.railway.internal:<the worker's PORT>) and the secret the poke carries (the api and
# the worker, one value; deployed: 32+ printable characters, `openssl rand -hex 32`; this
# placeholder is refused there). Both are required outside local, and the address is https or http
# to a *.railway.internal host; locally, without the address the api pokes nothing and the relay
# keeps to its own timer.
WORKER_INTERNAL_URL=http://localhost:3001
WORKER_WAKE_SECRET=local-only-worker-wake-secret-not-for-deployment
# The api signs Centrifugo's connection and subscription tokens (10 minutes each) with the
# Centrifugo service's CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY (docker-compose.yml's).
# Required in production (32+ characters; this local one is refused there); unset turns live
# updates off, as in previews.
CENTRIFUGO_TOKEN_SECRET=local-centrifugo-token-secret

# ── Load harness (spec 0011) ─────────────────────────────────────────────────
# The load commands (`pnpm load:stack`, `load:seed`, `load:sessions`, later `load:run`) read only these,
# never the variables above, and refuse any address that isn't localhost. Unset, each points at the
# load stack (docker-compose.load.yml), which is apart from the dev stack.
# LOAD_DATABASE_URL_OWNER=postgres://crm_owner:crm_owner_local@localhost:5434/crm
# LOAD_PGBOUNCER_URL=postgres://crm_app_user:local-only-load-app@localhost:6434/crm
# LOAD_IDENTITY_DATABASE_URL=postgres://crm_identity_user:local-only-load-identity@localhost:5434/crm
# LOAD_API_URL=http://localhost:3100
# LOAD_CENTRIFUGO_URL=ws://localhost:8100/connection/websocket
# `pnpm load:sessions` signs only with the load stack's fixed local-only secret, and refuses any other here.
# LOAD_BETTER_AUTH_SECRET=local-only-load-stack-better-auth-secret

# ── Joining with later features (listed so nothing is a surprise) ───────────
# Files (#32):        R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
# Monitoring (#11):   SENTRY_DSN_WEB, SENTRY_DSN_SERVER, SENTRY_AUTH_TOKEN, SENTRY_RELEASE, POSTHOG_KEY, POSTHOG_HOST
